{:paths ["src"]
 :deps {io.github.kotoba-lang/dom-gpu {:local/root "../dom-gpu"}
        ;; An inline `style="..."` attribute is a CSS declaration block, so
        ;; cssom parses it -- see the "inline style" section comment in
        ;; src/htmldom/core.cljc. cssom does not depend on this repo, so
        ;; there is no cycle.
        io.github.kotoba-lang/cssom {:local/root "../cssom"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
